{
  "name": "@t0.labs/daxta",
  "version": "0.5.2",
  "description": "DAxTA — Tested behavior. Trusted API docs. Generate API documentation from observed test execution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0-labs/daxta.git"
  },
  "homepage": "https://github.com/t0-labs/daxta#readme",
  "bugs": {
    "url": "https://github.com/t0-labs/daxta/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "daxta": "bin/daxta.js"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./jest-reporter": {
      "types": "./dist/jest/reporter.d.ts",
      "default": "./dist/jest/reporter.js"
    },
    "./jest-global-setup": {
      "types": "./dist/jest/global-setup.d.ts",
      "default": "./dist/jest/global-setup.js"
    },
    "./jest-global-teardown": {
      "types": "./dist/jest/global-teardown.d.ts",
      "default": "./dist/jest/global-teardown.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-transformer": ">=0.5.0",
    "class-validator": ">=0.14.0",
    "reflect-metadata": ">=0.1.13",
    "typescript": ">=4.9.0"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
